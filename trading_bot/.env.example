# Alpaca API credentials — get these from https://app.alpaca.markets
# Paper trading keys and live trading keys are different, generate them separately.
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# true = paper trading endpoint (https://paper-api.alpaca.markets)
# false = live trading endpoint (https://api.alpaca.markets) — real money, use with caution
ALPACA_PAPER=true

# Comma-separated list of symbols to watch (used unless USE_NASDAQ100=true)
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA

# true = ignore WATCHLIST and scan the full Nasdaq-100 instead (see nasdaq100.py)
USE_NASDAQ100=false

# --- Trading mode ---
# standard = longer-term swing trading (SMA 50/200, 15Min bars, wider stops)
# fast     = shorter-term trading (SMA 9/21, 5Min bars, tighter stops, smaller
#            position size) -- see README.md for the tradeoffs before using it
# Sets sensible defaults for TIMEFRAME, CHECK_INTERVAL_MINUTES, SMA_FAST,
# SMA_SLOW, POSITION_SIZE_PCT, STOP_LOSS_PCT and TAKE_PROFIT_PCT below.
# Leave those commented out to use the mode's defaults, or uncomment any one
# of them to override it regardless of TRADING_MODE.
TRADING_MODE=standard

# Bar timeframe used for indicator calculation: 1Min,5Min,15Min,1Hour,1Day
# Default: 15Min (standard) / 5Min (fast)
# TIMEFRAME=15Min

# How often (in minutes) the bot scans the watchlist
# Default: 15 (standard) / 5 (fast)
# CHECK_INTERVAL_MINUTES=15

# --- Batching (only matters for large watchlists like Nasdaq-100) ---
# Symbols per market-data request; keeps requests/minute well under Alpaca's
# rate limits instead of firing one HTTP call per symbol.
DATA_BATCH_SIZE=30
# Pause between batches, in seconds.
DATA_BATCH_PAUSE_SECONDS=1.0

# --- Strategy parameters ---
# SMA periods are mode-aware, default: 50/200 (standard) / 9/21 (fast)
# SMA_FAST=50
# SMA_SLOW=200
# RSI and MACD periods are identical in both modes
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# --- Risk management ---
# Max % of account equity risked per single trade (position sizing)
# Mode-aware, default: 2.0 (standard) / 1.0 (fast)
# POSITION_SIZE_PCT=2.0
# Stop-loss and take-profit distance from entry, in percent
# Mode-aware, default: 2.0/4.0 (standard) / 1.0/2.0 (fast)
# STOP_LOSS_PCT=2.0
# TAKE_PROFIT_PCT=4.0
# Trading halts for the rest of the day once realized loss exceeds this % of
# starting equity. Hard limit, identical in both modes -- TRADING_MODE=fast
# does NOT loosen this.
MAX_DAILY_LOSS_PCT=3.0

# --- Pattern-Modul (Trendlinien-/Chartmuster-Erkennung, siehe patterns.py) ---
# Komplett optional, per Default aus. true = zusaetzliches Signal aus
# automatisch erkannten Trendlinien/Mustern fliesst in die Entscheidung ein
# (bestaetigt/verwirft ein bestehendes BUY/SELL-Signal, loest aber nie
# selbst einen Trade aus). Siehe README.md fuer Details.
PATTERN_ENABLED=false

# Anzahl Kerzen links/rechts fuer die Swing-High/Low-Erkennung
PATTERN_PIVOT_WINDOW=4
# Mindest-/Maximalanzahl Pivots, durch die eine Trendlinie gefittet wird
PATTERN_MIN_TRENDLINE_PIVOTS=3
PATTERN_MAX_TRENDLINE_PIVOTS=5
# Wie weit der Kurs ueber/unter die Trendlinie schliessen muss, um als
# "signifikanter" Ausbruch zu zaehlen (in Prozent des Linienwerts)
PATTERN_BREAKOUT_THRESHOLD_PCT=0.3
# Mindest-Konfidenz (0-1), damit das Pattern-Signal im "confirm"-Modus ein
# bestehendes Signal bestaetigen darf
PATTERN_MIN_CONFIDENCE=0.5
# "confirm"  = Pattern-Signal muss dem Indikator-Signal zustimmen, sonst HOLD
# "weighted" = gewichtete Kombination aus Indikator- und Pattern-Score
PATTERN_COMBINE_MODE=confirm
# Gewicht des Pattern-Anteils bei PATTERN_COMBINE_MODE=weighted (0-1)
PATTERN_WEIGHT=0.4
# Toleranz (in Prozent) fuer das Clustern von Pivots zu Support/Resistance-
# Zonen bzw. fuer die Double-Top/Bottom-Erkennung
PATTERN_SR_ZONE_TOLERANCE_PCT=0.5

# Path to the CSV trade log
TRADE_LOG_PATH=trades.csv

# --- Telegram-Benachrichtigung bei fehlgeschlagenen Trades (siehe notifier.py) ---
# Komplett optional -- leer lassen, um diese Sofort-Benachrichtigungen
# auszuschalten (Fehlschlaege werden dann weiterhin normal geloggt, nur
# ohne Telegram-Nachricht). Kann denselben Bot/Chat wie deploy/notify.conf
# verwenden oder einen eigenen -- beides ist unabhaengig voneinander.
# Bot-Token vom @BotFather, Chat-ID z.B. ueber @userinfobot herausfinden.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
